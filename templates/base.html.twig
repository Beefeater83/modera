<!DOCTYPE html>
<html lang="uk">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="{{ asset('css/base.css') }}">
        <link rel="stylesheet" href="{{ asset('css/mobile-nav.css') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
        <script src="{{ asset('js/auth.js') }}" defer></script>
        <script src="{{ asset('js/brand-parallax.js') }}" defer></script>
        <script src="{{ asset('js/mobile-nav.js') }}" defer></script>
    </head>
    <body>
        {% block navigation %}
            {# ── Desktop navigation (≥ 900 px) ─────────────────────────────── #}
            <nav class="app-nav" aria-label="Main navigation">
                <div class="nav-container">
                    <a href="/" class="nav-brand">Modera Ukraine</a>

                    <div class="nav-links" id="protected-nav" hidden>
                        <a href="/contracts"
                           class="nav-link {% if app.request.pathInfo starts with '/contracts' %}active{% endif %}">
                            Contracts
                        </a>
                        <a href="/invoices"
                           class="nav-link {% if app.request.pathInfo starts with '/invoices' %}active{% endif %}">
                            Invoices
                        </a>
                    </div>

                    <div class="nav-auth">
                        <span id="current-user" hidden></span>

                        <button type="button" class="btn btn-secondary"
                                id="passkey-menu-btn" hidden>
                            Passkey menu
                        </button>

                        <button type="button" class="btn btn-primary"
                                id="authenticateBtn" hidden>
                            Authenticate
                        </button>

                        <button type="button" class="btn btn-primary"
                                id="logout-btn" hidden>
                            Sign out
                        </button>
                    </div>
                </div>
            </nav>

            {# ── Mobile header (< 900 px) ───────────────────────────────────── #}
            <header class="mobile-header" aria-label="Mobile navigation">
                <a href="/" class="nav-brand mobile-brand">Modera Ukraine</a>
                <button
                    class="hamburger"
                    id="hamburger-btn"
                    type="button"
                    aria-label="Open menu"
                    aria-expanded="false"
                    aria-controls="mobile-sidebar">
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                </button>
            </header>

            {# ── Overlay behind sidebar ─────────────────────────────────────── #}
            <div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>

            {# ── Mobile sidebar ─────────────────────────────────────────────── #}
            <nav class="mobile-sidebar"
                 id="mobile-sidebar"
                 aria-label="Mobile menu"
                 aria-hidden="true">

                <div class="sidebar-header">
                    <button
                        class="sidebar-close"
                        id="sidebar-close-btn"
                        type="button"
                        aria-label="Close menu">
                        ✕
                    </button>
                </div>

                <div class="sidebar-links">
                    <a href="/"
                       class="sidebar-link {% if app.request.pathInfo == '/' %}active{% endif %}">
                        Homepage
                    </a>

                    <div class="sidebar-protected-links" id="mob-protected-nav" hidden>
                        <a href="/contracts"
                           class="sidebar-link {% if app.request.pathInfo starts with '/contracts' %}active{% endif %}">
                            Contracts
                        </a>
                        <a href="/invoices"
                           class="sidebar-link {% if app.request.pathInfo starts with '/invoices' %}active{% endif %}">
                            Invoices
                        </a>
                    </div>
                </div>

                <div class="sidebar-divider" id="mob-auth-divider"></div>

                <div class="sidebar-auth">
                    <span id="mob-current-user" hidden></span>

                    <button type="button" class="sidebar-auth-btn btn-secondary-sidebar"
                            id="mob-passkey-menu-btn" hidden>
                        Passkey menu
                    </button>

                    <button type="button" class="sidebar-auth-btn btn-primary-sidebar"
                            id="mob-authenticate-btn" hidden>
                        Authenticate
                    </button>

                    <button type="button" class="sidebar-auth-btn btn-primary-sidebar"
                            id="mob-logout-btn" hidden>
                        Sign out
                    </button>
                </div>
            </nav>
        {% endblock %}

        {% block body %}{% endblock %}

        <div id="passkey-modal" class="passkey-modal" hidden>
            <div class="passkey-modal-content">
                <h2>Your Passkeys</h2>

                <div id="passkey-list" class="passkey-list"></div>

                <button type="button" class="passkey-provider" id="create-passkey-btn">
                    <span>🔐</span>
                    <span>Create new Passkey</span>
                </button>

                <button type="button" class="passkey-cancel" id="close-passkey-btn">
                    Cancel
                </button>
            </div>
        </div>
    </body>
</html>
