
{% extends 'base.html.twig' %}

{% block title %}Modera{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
{% endblock %}

{% block body %}
    <div class="container">
        <div class="home-hero">

            <div id="auth-status"
                 class="auth-status"
                 role="status"
                 aria-live="polite"
                 hidden></div>

            <div class="home-visual">
                <div class="home-placeholder-text">
                    Modera
                </div>

                <div class="home-media-placeholder">
                    <div class="brand-scene" id="brand-scene">
                        <span class="core-shadow"></span>
                        <img class="brand-core" src="{{ asset('icons/sphere.png') }}" alt="">

                        <div class="brand-item brand-1" data-depth="0.30">
                            <span class="brand-shadow"></span>
                            <img src="{{ asset('icons/ford.png') }}" alt="">
                        </div>

                        <div class="brand-item brand-2" data-depth="0.18">
                            <span class="brand-shadow"></span>
                            <img src="{{ asset('icons/jaguar.png') }}" alt="">
                        </div>

                        <div class="brand-item brand-3" data-depth="0.13">
                            <span class="brand-shadow"></span>
                            <img src="{{ asset('icons/lexus.png') }}" alt="">
                        </div>

                        <div class="brand-item brand-4" data-depth="0.32">
                            <span class="brand-shadow"></span>
                            <img src="{{ asset('icons/lr.png') }}" alt="">
                        </div>

                        <div class="brand-item brand-5" data-depth="0.22">
                            <span class="brand-shadow"></span>
                            <img src="{{ asset('icons/mg.png') }}" alt="">
                        </div>

                        <div class="brand-item brand-6" data-depth="0.30">
                            <span class="brand-shadow"></span>
                            <img src="{{ asset('icons/nissan.png') }}" alt="">
                        </div>

                        <div class="brand-item brand-7" data-depth="0.25">
                            <span class="brand-shadow"></span>
                            <img src="{{ asset('icons/renault.png') }}" alt="">
                        </div>

                        <div class="brand-item brand-8" data-depth="0.34">
                            <span class="brand-shadow"></span>
                            <img src="{{ asset('icons/skoda.png') }}" alt="">
                        </div>

                        <div class="brand-item brand-9" data-depth="0.21">
                            <span class="brand-shadow"></span>
                            <img src="{{ asset('icons/toyota.png') }}" alt="">
                        </div>

                        <div class="brand-item brand-10" data-depth="0.29">
                            <span class="brand-shadow"></span>
                            <img src="{{ asset('icons/volvo.png') }}" alt="">
                        </div>

                        <div class="brand-item brand-11" data-depth="0.24">
                            <span class="brand-shadow"></span>
                            <img src="{{ asset('icons/vw.png') }}" alt="">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="auth-modal" class="auth-modal" hidden>
        <div class="auth-modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="auth-modal-title">

            <h2 id="auth-modal-title">Choose authentication</h2>

            <button type="button" class="auth-provider"
                    id="google-login">
                <img src="{{ asset('icons/google.svg') }}" alt="">
                <span>Continue with Google</span>
            </button>

            <button type="button" class="auth-provider"
                    id="github-login">
                <img src="{{ asset('icons/github.svg') }}" alt="">
                <span>Continue with GitHub</span>
            </button>

            <button type="button" class="auth-provider" id="passkey-login">
                <span>🔐</span>
                <span>Continue with Passkey</span>
            </button>

            <div class="auth-divider">
                <span>or</span>
            </div>

            <div class="otp-login">
                <h3>Sign in with one-time code</h3>

                <form id="otp-request-form">
                    <label for="otp-email" class="visually-hidden">
                        Email address
                    </label>

                    <input
                        id="otp-email"
                        class="auth-input"
                        type="email"
                        placeholder="Email address"
                        autocomplete="email"
                        required
                    >

                    <button type="submit" class="auth-provider otp-btn" id="otp-request-btn">
                        Send verification code
                    </button>
                </form>

                <form id="otp-verify-form" hidden>
                    <label for="otp-code" class="visually-hidden">
                        Verification code
                    </label>

                    <input
                        id="otp-code"
                        class="auth-input"
                        type="text"
                        inputmode="numeric"
                        pattern="[0-9]{6}"
                        maxlength="6"
                        autocomplete="one-time-code"
                        placeholder="6-digit verification code"
                        required
                    >

                    <button type="submit" class="auth-provider otp-btn" id="otp-verify-btn">
                        Verify and sign in
                    </button>
                </form>

                <div id="otp-message" class="otp-message"></div>
            </div>

            <button type="button" class="auth-cancel" id="auth-cancel">
                Cancel
            </button>
        </div>
    </div>
{% endblock %}
